# Copy to .env.local and adjust as needed.

# Where the Vite dev/preview server forwards /api requests and the /ws WebSocket.
API_PROXY_TARGET=http://localhost:8080

# Leave empty to use the proxy above. For a production build served from a
# different address than the API, set the API's base URL, e.g.
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
